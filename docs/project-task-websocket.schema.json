{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Octop Task WebSocket Protocol 1",
  "description": "Authenticated task commands, durable client tools and server events for /api/project-tasks/ws.",
  "$comment": "Generated by scripts/export_task_websocket_schema.py. Read project-task-websocket.md for permissions, schema restrictions, ordering, idempotency and lifecycle rules.",
  "oneOf": [
    {
      "$ref": "#/$defs/AuthenticateFrame"
    },
    {
      "$ref": "#/$defs/ClientCommand"
    },
    {
      "$ref": "#/$defs/ServerEvent"
    }
  ],
  "$defs": {
    "AttachFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "client.attach",
          "title": "Type",
          "type": "string"
        },
        "client_id": {
          "description": "稳定的客户端安装标识；连接内不可切换。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Client Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "client_id"
      ],
      "title": "AttachFrame",
      "type": "object"
    },
    "CancelFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.cancel",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TaskCancel"
        }
      },
      "required": [
        "id",
        "type",
        "task_id",
        "data"
      ],
      "title": "CancelFrame",
      "type": "object"
    },
    "ClientToolDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "description": "Draft 2020-12 JSON Schema，根 type 必须为 object；仅支持文档内引用。",
          "title": "Input Schema",
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "title": "ClientToolDefinition",
      "type": "object"
    },
    "ClientToolResult": {
      "additionalProperties": false,
      "properties": {
        "claim_token": {
          "pattern": "^[A-Za-z0-9_-]{16,256}$",
          "title": "Claim Token",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "description": "客户端执行结果或可供模型理解的错误信息，最多 256 KiB。"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        }
      },
      "required": [
        "claim_token",
        "output"
      ],
      "title": "ClientToolResult",
      "type": "object"
    },
    "CreateFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.create",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TaskCreate"
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "title": "CreateFrame",
      "type": "object"
    },
    "JsonValue": {},
    "MessageFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.message",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TaskMessage"
        }
      },
      "required": [
        "id",
        "type",
        "task_id",
        "data"
      ],
      "title": "MessageFrame",
      "type": "object"
    },
    "OpenFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.open",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "description": "用户明确进入详情的任务；按需补生成缺少的语义标题。",
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "task_id"
      ],
      "title": "OpenFrame",
      "type": "object"
    },
    "PingFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "ping",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "PingFrame",
      "type": "object"
    },
    "RetryFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.retry",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TaskRetry"
        }
      },
      "required": [
        "id",
        "type",
        "task_id",
        "turn_id",
        "data"
      ],
      "title": "RetryFrame",
      "type": "object"
    },
    "SkillBinding": {
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "slug": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "package_id",
        "slug"
      ],
      "title": "SkillBinding",
      "type": "object"
    },
    "SkillHubBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "skillhub",
          "title": "Source",
          "type": "string"
        },
        "slug": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "description": "SkillHub 展示名。",
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "SkillHub 展示简介。",
          "maxLength": 4096,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "source",
        "slug",
        "name"
      ],
      "title": "SkillHubBinding",
      "type": "object"
    },
    "SubscribeFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.subscribe",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "required": [
        "id",
        "type",
        "task_id"
      ],
      "title": "SubscribeFrame",
      "type": "object"
    },
    "TaskCancel": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "description": "用户要停止的轮次；不会取消其他轮次。",
          "maxLength": 256,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id"
      ],
      "title": "TaskCancel",
      "type": "object"
    },
    "TaskCreate": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "description": "本次发送的唯一标识；网络重试必须复用，相同标识不会重复执行。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "prompt": {
          "description": "本轮用户消息。发送后开始一次执行。",
          "maxLength": 32768,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/TaskExecutionOptions",
          "description": "本轮执行选项；省略时使用当前项目及默认模型，不修改项目。"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "所属独立项目；null 创建无项目任务。",
          "title": "Project Id"
        }
      },
      "required": [
        "request_id",
        "prompt"
      ],
      "title": "TaskCreate",
      "type": "object"
    },
    "TaskExecutionOptions": {
      "additionalProperties": false,
      "properties": {
        "reasoning_mode": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "enabled",
                "disabled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮思考模式；省略或 null 使用所选模型默认值。不支持的设置返回 422。",
          "title": "Reasoning Mode"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮思考强度，必须来自所选模型 reasoning_config.efforts；省略或 null 使用模型默认值。",
          "title": "Reasoning Effort"
        },
        "model_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮模型；省略或 null 使用当前默认模型。",
          "title": "Model Ref"
        },
        "skills": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SkillBinding"
                  },
                  {
                    "$ref": "#/$defs/SkillHubBinding"
                  }
                ]
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮完整 Skill 选择；省略或 null 继承项目，[] 本轮禁用。",
          "title": "Skills"
        },
        "mcp_servers": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮完整 MCP 选择；省略或 null 继承项目，[] 本轮禁用。",
          "title": "Mcp Servers"
        },
        "plugins": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮插件；省略或 null 继承项目，[] 禁用。",
          "title": "Plugins"
        },
        "subagents": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 16,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮子代理角色；省略或 null 继承项目，[] 清空角色。",
          "title": "Subagents"
        },
        "memory_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮是否启用任务持久记忆；省略或 null 继承项目。",
          "title": "Memory Enabled"
        },
        "team_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮是否启用任务内团队同步协作；省略或 null 继承项目。",
          "title": "Team Enabled"
        },
        "client_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮客户端工具执行端标识；与 client.attach 一致。",
          "title": "Client Id"
        },
        "client_tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ClientToolDefinition"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "本轮可调用的客户端工具；不继承前轮或项目。",
          "title": "Client Tools"
        }
      },
      "title": "TaskExecutionOptions",
      "type": "object"
    },
    "TaskMessage": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "description": "本次发送的唯一标识；网络重试必须复用，相同标识不会重复执行。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "prompt": {
          "description": "本轮用户消息。发送后开始一次执行。",
          "maxLength": 32768,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/TaskExecutionOptions",
          "description": "本轮执行选项；省略时使用当前项目及默认模型，不修改项目。"
        }
      },
      "required": [
        "request_id",
        "prompt"
      ],
      "title": "TaskMessage",
      "type": "object"
    },
    "TaskRetry": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "description": "本次重试的唯一标识；网络重传必须复用。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/TaskExecutionOptions",
          "description": "本轮执行选项；省略时使用当前项目及默认模型，不修改项目。"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "TaskRetry",
      "type": "object"
    },
    "ToolClaimFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "type": {
          "const": "tool.claim",
          "title": "Type",
          "type": "string"
        },
        "request_id": {
          "description": "本次领取的稳定标识；恢复领取必须复用。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "turn_id",
        "call_id",
        "type",
        "request_id"
      ],
      "title": "ToolClaimFrame",
      "type": "object"
    },
    "ToolGetFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "type": {
          "const": "tool.get",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "turn_id",
        "call_id",
        "type"
      ],
      "title": "ToolGetFrame",
      "type": "object"
    },
    "ToolResultFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "call_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "type": {
          "const": "tool.result",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClientToolResult"
        }
      },
      "required": [
        "id",
        "task_id",
        "turn_id",
        "call_id",
        "type",
        "data"
      ],
      "title": "ToolResultFrame",
      "type": "object"
    },
    "UnsubscribeFrame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "关联本次命令响应；网络重发使用新的命令 ID。",
          "pattern": "^[A-Za-z0-9_-]{8,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "task.unsubscribe",
          "title": "Type",
          "type": "string"
        },
        "task_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "task_id"
      ],
      "title": "UnsubscribeFrame",
      "type": "object"
    },
    "ClientCommand": {
      "discriminator": {
        "mapping": {
          "client.attach": "#/$defs/AttachFrame",
          "ping": "#/$defs/PingFrame",
          "task.cancel": "#/$defs/CancelFrame",
          "task.create": "#/$defs/CreateFrame",
          "task.message": "#/$defs/MessageFrame",
          "task.open": "#/$defs/OpenFrame",
          "task.retry": "#/$defs/RetryFrame",
          "task.subscribe": "#/$defs/SubscribeFrame",
          "task.unsubscribe": "#/$defs/UnsubscribeFrame",
          "tool.claim": "#/$defs/ToolClaimFrame",
          "tool.get": "#/$defs/ToolGetFrame",
